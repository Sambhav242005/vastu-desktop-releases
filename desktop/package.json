{
  "name": "vastu-grid-desktop",
  "productName": "Vastu Grid",
  "version": "1.1.14",
  "description": "Offline Vastu and Kundli workspace for Windows",
  "author": "Sambhav",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --x64 --dir --publish never",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "verify": "node --test tests/*.test.cjs",
    "smoke": "node tests/smoke.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "@playwright/test": "1.64.1"
  },
  "build": {
    "appId": "com.sambhav24.vastu.desktop",
    "productName": "Vastu Grid",
    "asar": true,
    "directories": {
      "output": "../release-artifacts/desktop"
    },
    "files": [
      "*.cjs",
      "package.json",
      "web-dist/**/*",
      "assets/icon.ico"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Vastu-Grid-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Sambhav242005",
      "repo": "vastu-desktop-releases",
      "releaseType": "draft"
    }
  }
}
